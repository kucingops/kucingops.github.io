---
import Base from '../layouts/Base.astro';
import Window from '../components/Window.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../utils';
const posts = (await getPosts()).slice(0, 5);
---
<Base>
  <Window title="✨ Welcome">
    <div class="hero">
      <img src="https://github.com/kucingops.png" alt="Foto profil kucingops" width="120" height="120" />
      <div>
        <h1>Hi, saya Syarif</h1>
        <p class="lead">Software engineer dari Bogor, Indonesia</p>
        <p class="muted">Tempat saya menulis apa saja: catatan teknis, cerita, opini, atau hal random yang lagi kepikiran.</p>
      </div>
    </div>
  </Window>
  <Window title="📝 Tulisan terbaru">
    <PostList posts={posts} />
    <p><a href="/blog/">Semua tulisan →</a></p>
  </Window>
</Base>
